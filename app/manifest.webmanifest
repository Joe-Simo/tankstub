{
  "id": "/tankstub/app/",
  "name": "Tankstub",
  "short_name": "Tankstub",
  "description": "Log fill-ups and see real fuel economy from full tank to full tank on your Windows PC. Import and export CSV, track cost per mile or kilometer, and review your spending. Your data stays on this PC.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/tankstub/app/",
  "scope": "/tankstub/app/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "theme_color": "#1d3f7a",
  "background_color": "#edf1f7",
  "categories": [
    "utilities",
    "finance",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon-16.png",
      "sizes": "16x16",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-20.png",
      "sizes": "20x20",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-24.png",
      "sizes": "24x24",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-40.png",
      "sizes": "40x40",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-64.png",
      "sizes": "64x64",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-256.png",
      "sizes": "256x256",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add a fill-up",
      "short_name": "Add fill-up",
      "url": "/tankstub/app/?new",
      "icons": [
        {
          "src": "icons/icon-96.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "widgets": [
    {
      "name": "Tankstub: Last tank",
      "short_name": "Last tank",
      "description": "Your average economy, last tank, and this month's fuel spend.",
      "tag": "last-tank",
      "template": "tankstub-last-tank",
      "ms_ac_template": "widgets/last-tank.ac.json",
      "data": "widgets/last-tank-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "widgets/screenshot-last-tank.png",
          "sizes": "600x400",
          "label": "The Last tank widget"
        }
      ],
      "icons": [
        {
          "src": "icons/icon-48.png",
          "sizes": "48x48"
        }
      ],
      "auth": false,
      "update": 21600,
      "multiple": false
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
